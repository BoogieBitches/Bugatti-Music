# ---------------------------------------------------------------------------
# Bugatti Sound — environment variables
# Copy this file to `.env.local` and fill in every value.
# On Vercel, add the same variables under Settings → Environment Variables.
# ---------------------------------------------------------------------------

# --- App ---------------------------------------------------------------------
# Public production URL (no trailing slash). Used to build Robokassa
# Success/Fail/Result URLs and email links.
NEXT_PUBLIC_APP_URL=https://bugattisound.online

# --- Supabase ----------------------------------------------------------------
# Settings → API in your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Required by the Robokassa webhook to activate Premium. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Robokassa (active payment provider) -------------------------------------
# ЛК Robokassa → Технические настройки.
ROBOKASSA_LOGIN=your-merchant-login
ROBOKASSA_PASSWORD1=your-password-1
ROBOKASSA_PASSWORD2=your-password-2
# Set to "1" to use Robokassa test mode; remove or set "0" for live payments.
ROBOKASSA_IS_TEST=1

# --- Cron (Premium auto-renewal) ---------------------------------------------
# Shared secret protecting /api/robokassa/autopay (called by Vercel Cron).
CRON_SECRET=generate-a-long-random-string

# --- Admin -------------------------------------------------------------------
# Comma-separated list of emails allowed to bootstrap the admin role.
ADMIN_EMAILS=you@example.com

# --- Email (Resend) — optional, used for autopay-declined notifications ------
RESEND_API_KEY=
RESEND_FROM=Bugatti Sound <noreply@bugattisound.online>

# --- Telegram login (optional) ----------------------------------------------
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=

# --- CloudPayments (legacy / optional, not used by the current UI) -----------
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_SECRET_KEY=
